# ============================================================
# AgentForge 后端环境变量
# 复制为 .env 后按实际环境填写
# [必填] = 启动必需   [可选] = 有默认值或留空降级
# ============================================================

# ---------- LLM 网关 ----------

# [必填] OpenAI 兼容网关 API Key（langchain-openai ChatOpenAI 调用时必需）
OPENAI_API_KEY=

# ---------- 应用基础 ----------

# [可选] CORS 允许源，多个用逗号分隔（默认 http://localhost:5173）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# [可选] 调试模式（默认 false）
DEBUG=false
# [可选] 是否启用 Swagger/ReDoc 文档（默认 true）
API_DOCS_ENABLED=true
# [可选] FastAPI root_path，用于反向代理场景（默认空）
ROOT_PATH=
# [可选] 日志目录路径（默认 logs）
LOG_DIR=logs

# ---------- MySQL 数据库 ----------

# [必填] 数据库连接 URL；格式须为 mysql+pymysql://（Alembic 与同步工具使用）
# 应用运行时自动转为 mysql+aiomysql 异步驱动
# SQLite 异步：sqlite+aiosqlite:///path/to/db（pytest 默认内存库 sqlite+aiosqlite:///:memory:）
DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/ai_agents
# [可选] 连接池取出连接前预 ping（默认 true）；设 false 可略减延迟，生产慎用
# DB_POOL_PRE_PING=true

# ---------- MongoDB（知识库分片） ----------

# [必填] MongoDB 连接串；知识库 knowledge_chunks 集合读写
MONGODB_URL=mongodb://127.0.0.1:27017
# [可选] MongoDB 数据库名（默认 ai_agents）
# MONGODB_DATABASE=ai_agents

# ---------- Redis（可选） ----------

# [可选] 异步 Redis 连接串；留空则业务降级为仅 DB，不启用缓存
# REDIS_URL=redis://127.0.0.1:6379/0
# [可选] Redis 连接池上限（默认 50，最小 1）
# REDIS_MAX_CONNECTIONS=50

# ---------- Milvus 向量数据库（可选） ----------

# [可选] Milvus 连接 URI；留空则不做向量入库与 ANN 检索，仅 MongoDB 关键词搜索
# MILVUS_URI=http://127.0.0.1:19530
# [可选] Milvus 鉴权 token
# MILVUS_TOKEN=
# [可选] 向量检索经 Milvus TextNode 再映射路径（调试用，默认 false）
# KNOWLEDGE_VECTOR_SEARCH_USE_LI_NODES=false

# ---------- MinIO / S3 兼容对象存储（知识库上传） ----------

# [条件必填] 启用知识库文件上传时以下三项均须填写
# endpoint 不含 scheme，如 127.0.0.1:9000
# MINIO_ENDPOINT=127.0.0.1:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# [可选] 知识库对象桶名（默认 knowledge）
# MINIO_BUCKET_KNOWLEDGE=knowledge

# ---------- Agent 图执行 ----------

# [可选] LangGraph 单轮最大步数（模型/工具交替），范围 8-512（默认 100）
# 多子 Agent 编排或长 ReAct 触顶时可调大
# AGENT_GRAPH_RECURSION_LIMIT=100

# ---------- LangSmith 可观测（可选） ----------

# [可选] 启用 LangSmith 追踪（设为 true 开启）
# LANGCHAIN_TRACING_V2=true
# [可选] LangSmith API Key（https://smith.langchain.com）
# LANGCHAIN_API_KEY=lsv2_pt_xxxxxxxx
# [可选] LangSmith 项目名（默认 default）
# LANGCHAIN_PROJECT=agent-forge

# ---------- 测试专用 ----------

# [可选] pytest 专用数据库 URL；不设则默认 sqlite+aiosqlite:///:memory:
# TEST_DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/ai_agents_test
# [可选] 设为 1 时 pytest 使用 .env 的 DATABASE_URL（MySQL）而非默认 SQLite
# TEST_USE_MYSQL=1
